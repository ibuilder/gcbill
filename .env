# ---------------------------------
# Application Environment & URL
# ---------------------------------
# Set to 'development', 'staging', or 'production'
APP_ENV=development
# Enable debug mode (true/false) - SET TO FALSE IN PRODUCTION
APP_DEBUG=true
# Base URL of the application
APP_URL=http://localhost:8000 # Or your local dev domain like http://gcbill.local

# ---------------------------------
# Database Configuration
# ---------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gcbill_db # Replace with your database name
DB_USERNAME=root      # Replace with your database username
DB_PASSWORD=          # Replace with your database password (keep empty if none, but use quotes if password has special chars: 'p@$$wOrd')

# ---------------------------------
# Session & Security
# ---------------------------------
# A long, random string for security purposes (e.g., CSRF, encryption if used)
APP_KEY=base64:YourRandom32ByteKeyHere= # Generate one using `php -r "echo base64_encode(random_bytes(32));"`
SESSION_DRIVER=file # Or database, redis, etc.
SESSION_LIFETIME=120 # Minutes

# ---------------------------------
# Mail Configuration (Optional)
# ---------------------------------
# MAIL_MAILER=smtp
# MAIL_HOST=mailhog
# MAIL_PORT=1025
# MAIL_USERNAME=null
# MAIL_PASSWORD=null
# MAIL_ENCRYPTION=null
# MAIL_FROM_ADDRESS="hello@example.com"
# MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------
# Other Services (Optional)
# ---------------------------------
# Example: Redis
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379
