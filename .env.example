# filepath: c:\Users\iphoe\OneDrive\Documents\Server\construction-billing\production\construction-billing-app\.env.example
# App Configuration
APP_NAME="Construction Billing"
APP_ENV=development
APP_KEY=base64:YourSecretKeyHereGenerateOne! # Generate using: php -r 'echo base64_encode(random_bytes(32));'
APP_DEBUG=true
APP_URL=http://localhost:8000 # Or your local dev URL
APP_TIMEZONE=America/New_York

# Database Configuration
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=construction_billing
DB_USERNAME=root
DB_PASSWORD=

# Session Configuration
SESSION_DRIVER=file
SESSION_LIFETIME=86400
SESSION_COOKIE=construction_billing_session
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=false

# Mail Configuration (Example using Mailtrap.io for development)
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=your_mailtrap_username
MAIL_PASSWORD=your_mailtrap_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"